# Secret scan of what is about to be committed. CI runs the same scan over the
# whole history, so a machine without gitleaks only loses the early warning.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --redact --no-banner || exit 1
else
  echo "gitleaks is not installed - skipping the local secret scan (CI still runs it). brew install gitleaks" >&2
fi
bunx lint-staged
